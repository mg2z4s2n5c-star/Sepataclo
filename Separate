        }

        function renderTimeline(items, container) {
            let html = `<div class="relative pl-6 sm:pl-8 border-l-2 border-indigo-500/30 space-y-8 my-4">`;

            items.forEach((photo) => {
                const origIndex = photos.findIndex(p => p.id === photo.id);
                html += `
                    <div class="relative group">
                        <!-- Bullet Dot -->
                        <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-6 h-6 rounded-full ${photo.isChecked ? 'bg-emerald-500' : 'bg-indigo-600'} border-4 border-slate-950 flex items-center justify-center text-[10px] font-bold text-white shadow-lg">
                            ${photo.id}
                        </div>

                        <!-- Card Content -->
                        <div class="glass-panel rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row gap-4 items-center">
                            <div class="relative aspect-video w-full sm:w-56 rounded-xl overflow-hidden bg-slate-950 flex-shrink-0 cursor-pointer" onclick="openSlideshow(${origIndex})">
                                <img src="${photo.url}" onerror="this.onerror=null; this.src='${photo.fallbackUrl}'" alt="${photo.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                                <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition"></div>
                                <div class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-black/80 text-[10px] font-mono font-bold text-slate-200">${photo.duration || ''}</div>
                                
                                <button onclick="event.stopPropagation(); triggerCardReplace(${origIndex})" title="この写真を差し替える" class="absolute top-2 left-2 px-2 py-1 rounded bg-slate-900/80 hover:bg-indigo-600 text-[10px] font-semibold text-slate-200 backdrop-blur-md border border-white/20 transition flex items-center gap-1">
                                    <i class="fa-solid fa-camera"></i> 差替
                                </button>
                            </div>

                            <div class="flex-1 space-y-2 w-full">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-950 text-indigo-300 border border-indigo-800/50">${photo.tag}</span>
                                    <div class="flex items-center space-x-2">
                                        <button onclick="toggleFavorite(${origIndex})" class="text-xs ${photo.isFavorite ? 'text-amber-400' : 'text-slate-600 hover:text-slate-400'}">
                                            <i class="fa-solid fa-star"></i>
                                        </button>
                                        <button onclick="openEditModal(${origIndex})" class="text-xs text-slate-400 hover:text-slate-200">
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </button>
                                    </div>
                                </div>
                                <h3 class="font-bold text-base text-slate-100">${photo.title}</h3>
                                <p class="text-xs text-slate-400 leading-relaxed">${photo.caption}</p>
                                
                                <div class="pt-2 flex items-center space-x-3">
                                    <button onclick="openSlideshow(${origIndex})" class="px-3 py-1.5 bg-indigo-600/80 hover:bg-indigo-600 text-white rounded-lg text-xs font-medium transition flex items-center space-x-1.5">
                                        <i class="fa-solid fa-play"></i> <span>スライドショー</span>
                                    </button>
                                    <button onclick="toggleCheckPhoto(${origIndex})" class="px-3 py-1.5 ${photo.isChecked ? 'bg-emerald-600 text-white' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'} rounded-lg text-xs font-medium transition flex items-center space-x-1.5">
                                        <i class="fa-solid ${photo.isChecked ? 'fa-check' : 'fa-plus'}"></i>
                                        <span>${photo.isChecked ? 'チェック済み' : 'チェック'}</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += `</div>`;
            container.innerHTML = html;
        }

        // Modal Operations
        function openEditModal(index) {
            editingIndex = index;
            const photo = photos[index];

            document.getElementById('modalTitle').innerText = `写真 #${photo.id} の編集`;
            document.getElementById('modalImagePreview').src = photo.url;
            document.getElementById('modalInputTitle').value = photo.title;
            document.getElementById('modalInputTag').value = photo.tag;
            document.getElementById('modalInputCaption').value = photo.caption;
            document.getElementById('modalInputFav').checked = photo.isFavorite;

            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
            editingIndex = null;
        }

        function saveModalChanges() {
            if (editingIndex === null) return;

            photos[editingIndex].title = document.getElementById('modalInputTitle').value;
            photos[editingIndex].tag = document.getElementById('modalInputTag').value;
            photos[editingIndex].caption = document.getElementById('modalInputCaption').value;
            photos[editingIndex].isFavorite = document.getElementById('modalInputFav').checked;

            closeEditModal();
            renderGallery();
            savePhotosToFirestore();
            showToast('変更内容を保存しました');
        }

        // Slideshow System
        function openSlideshow(index) {
            currentSlideIndex = index;
            updateSlideshow();
            document.getElementById('slideshowModal').classList.remove('hidden');
            startAutoPlay();
        }

        function closeSlideshow() {
            document.getElementById('slideshowModal').classList.add('hidden');
            stopAutoPlay();
        }

        function startAutoPlay() {
            stopAutoPlay();
            isAutoPlaying = true;
            updateAutoPlayUI();
            slideshowInterval = setInterval(() => {
                nextSlide(false);
            }, 3000);
        }

        function stopAutoPlay() {
            if (slideshowInterval) {
                clearInterval(slideshowInterval);
                slideshowInterval = null;
            }
            isAutoPlaying = false;
            updateAutoPlayUI();
        }

        function toggleAutoPlay() {
            if (isAutoPlaying) {
                stopAutoPlay();
            } else {
                startAutoPlay();
            }
        }

        function updateAutoPlayUI() {
            const btn = document.getElementById('autoPlayBtn');
            const icon = document.getElementById('autoPlayIcon');
            const text = document.getElementById('autoPlayText');
            if (!btn || !icon || !text) return;

            if (isAutoPlaying) {
                btn.className = "px-5 py-3 bg-emerald-600/90 hover:bg-emerald-600 text-sm sm:text-base font-bold rounded-full shadow-2xl backdrop-blur-md transition-all flex items-center space-x-2.5 border border-emerald-400/30 text-white hover:scale-105";
                icon.className = "fa-solid fa-pause text-lg";
                text.innerText = "ストップ (3秒再生中)";
            } else {
                btn.className = "px-5 py-3 bg-slate-800/90 hover:bg-slate-700 text-sm sm:text-base font-bold rounded-full shadow-2xl backdrop-blur-md transition-all flex items-center space-x-2.5 border border-slate-600/50 text-slate-200 hover:scale-105";
                icon.className = "fa-solid fa-play text-lg text-emerald-400";
                text.innerText = "自動再生";
            }
        }

        function toggleCheckCurrentSlide() {
            const photo = photos[currentSlideIndex];
            photo.isChecked = !photo.isChecked;
            updateSlideshowCheckBtn();
            renderGallery();
            savePhotosToFirestore();
            showToast(photo.isChecked ? `#${photo.id} にチェックを付けました` : `#${photo.id} のチェックを外しました`);
        }

        function updateSlideshowCheckBtn() {
            const photo = photos[currentSlideIndex];
            const btn = document.getElementById('slideshowCheckBtn');
            const icon = document.getElementById('slideshowCheckIcon');
            const text = document.getElementById('slideshowCheckText');
            if (!btn || !icon || !text) return;

            if (photo.isChecked) {
                btn.className = "px-5 py-3 rounded-full text-sm sm:text-base font-bold shadow-xl backdrop-blur-md transition-all flex items-center space-x-2.5 border border-emerald-400/50 bg-emerald-600 text-white hover:bg-emerald-500 scale-105";
                icon.className = "fa-solid fa-circle-check text-lg text-white";
                text.innerText = "チェック済み";
            } else {
                btn.className = "px-5 py-3 rounded-full text-sm sm:text-base font-bold shadow-xl backdrop-blur-md transition-all flex items-center space-x-2.5 border border-white/20 bg-slate-900/80 text-white hover:bg-slate-800";
                icon.className = "fa-regular fa-circle-check text-lg text-slate-300";
                text.innerText = "チェックする";
            }
        }

        function updateSlideshow() {
            const photo = photos[currentSlideIndex];
            document.getElementById('slideshowImg').src = photo.url;
            document.getElementById('slideshowTitle').innerText = photo.title;
            document.getElementById('slideshowCaption').innerText = photo.caption;
            document.getElementById('slideshowBadge').innerText = `#${photo.id} ${photo.tag}`;
            document.getElementById('slideshowCounter').innerText = `${currentSlideIndex + 1} / ${photos.length}`;
            updateSlideshowCheckBtn();
        }

        function prevSlide(userTriggered = true) {
            currentSlideIndex = (currentSlideIndex - 1 + photos.length) % photos.length;
            updateSlideshow();
            if (userTriggered && isAutoPlaying) {
                startAutoPlay();
            }
        }

        function nextSlide(userTriggered = true) {
            if (currentSlideIndex === photos.length - 1) {
                stopAutoPlay();
                closeSlideshow();
                showResultModal();
                return;
            }
            currentSlideIndex = (currentSlideIndex + 1) % photos.length;
            updateSlideshow();
            if (userTriggered && isAutoPlaying) {
                startAutoPlay();
            }
        }

        function showResultModal() {
            const checkedPhotos = photos.filter(p => p.isChecked);
            const container = document.getElementById('resultNumbersList');
            if (checkedPhotos.length > 0) {
                container.innerHTML = checkedPhotos.map(p => 
                    `<span class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-extrabold text-base shadow-lg shadow-emerald-500/10">#${p.id} ${p.title}</span>`
                ).join('');
            } else {
                container.innerHTML = `<p class="text-slate-400 text-sm py-2">チェックされた写真はありません</p>`;
            }
            document.getElementById('resultModal').classList.remove('hidden');
        }

        function closeResultModal() {
            document.getElementById('resultModal').classList.add('hidden');
        }

        // Keyboard Shortcuts
        document.addEventListener('keydown', (e) => {
            if (document.getElementById('slideshowModal').classList.contains('hidden')) return;
            if (e.key === 'ArrowLeft') prevSlide(true);
            if (e.key === 'ArrowRight') nextSlide(true);
            if (e.key === 'Escape') closeSlideshow();
            if (e.key === ' ') {
                e.preventDefault();
                toggleCheckCurrentSlide();
            }
        });

        // Touch Swipe Gestures on Slideshow
        let touchStartX = 0;
        let touchEndX = 0;
        const touchArea = document.getElementById('slideshowTouchArea');
        if (touchArea) {
            touchArea.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            touchArea.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                const diff = touchStartX - touchEndX;
                if (Math.abs(diff) > 40) {
                    if (diff > 0) nextSlide(true); // Swipe Left
                    else prevSlide(true); // Swipe Right
                }
            }, { passive: true });
        }

        // Global Bindings
        window.triggerUpload = triggerUpload;
        window.handleMultipleUpload = handleMultipleUpload;
        window.triggerCardReplace = triggerCardReplace;
        window.handleDirectCardReplace = handleDirectCardReplace;
        window.replaceSingleImageModal = replaceSingleImageModal;
        window.handleSingleReplace = handleSingleReplace;
        window.openSlideshow = openSlideshow;
        window.renderGallery = renderGallery;
        window.setViewMode = setViewMode;
        window.closeEditModal = closeEditModal;
        window.saveModalChanges = saveModalChanges;
        window.toggleAutoPlay = toggleAutoPlay;
        window.toggleCheckCurrentSlide = toggleCheckCurrentSlide;
        window.prevSlide = prevSlide;
        window.nextSlide = nextSlide;
        window.closeSlideshow = closeSlideshow;
        window.closeResultModal = closeResultModal;
        window.toggleFavorite = toggleFavorite;
        window.toggleCheckPhoto = toggleCheckPhoto;
        window.openEditModal = openEditModal;
    </script>
</body>
</html>
