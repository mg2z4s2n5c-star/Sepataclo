<!DOCTYPE html>
<html lang="ja" class="h-full bg-slate-900 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>10-Photo Storyboard & Gallery - セパタクロー特集</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Toast notification animation */
        @keyframes toastIn {
            from { transform: translateY(100%) scale(0.9); opacity: 0; }
            to { transform: translateY(0) scale(1); opacity: 1; }
        }
        .animate-toast {
            animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="h-full flex flex-col bg-slate-950 text-slate-100 overflow-x-hidden">

    <!-- Direct Hidden Single File Input for Quick Replace -->
    <input type="file" id="directCardFileInput" accept="image/*" class="hidden" onchange="handleDirectCardReplace(event)">

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-40 glass-panel border-b border-slate-800 px-4 lg:px-8 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                <i class="fa-solid fa-trophy text-white text-lg"></i>
            </div>
            <div>
                <h1 class="text-base sm:text-lg font-extrabold bg-gradient-to-r from-indigo-200 via-sky-200 to-pink-200 bg-clip-text text-transparent">
                    セパタクロー 10選 Storyboard
                </h1>
                <div class="flex items-center gap-2">
                    <p class="text-xs text-slate-400" id="photoCountBadge">10 / 10 枚の写真</p>
                    <span id="saveStatus" class="px-2 py-0.5 text-[10px] rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-medium inline-flex items-center gap-1">
                        <i class="fa-solid fa-cloud-check"></i> 保存済み
                    </span>
                </div>
            </div>
        </div>

        <div class="flex items-center space-x-2 sm:space-x-4">
            <button onclick="triggerUpload()" class="px-3 py-2 sm:px-4 sm:py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-medium rounded-xl shadow-lg shadow-indigo-600/30 transition flex items-center space-x-2">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <span class="hidden sm:inline">写真を一括差替</span>
            </button>
            <input type="file" id="multiFileInput" multiple accept="image/*" class="hidden" onchange="handleMultipleUpload(event)">

            <button onclick="openSlideshow(0)" class="px-3 py-2 sm:px-4 sm:py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs sm:text-sm font-bold rounded-xl shadow-lg shadow-emerald-600/20 transition flex items-center space-x-2">
                <i class="fa-solid fa-play"></i>
                <span>スライドショー開始</span>
            </button>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 lg:px-8 py-6 space-y-6">

        <!-- Controls & Filters -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 glass-panel p-4 rounded-2xl">
            <!-- Search & Filter -->
            <div class="flex flex-wrap items-center gap-3 flex-1">
                <div class="relative flex-1 min-w-[200px]">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="searchInput" oninput="renderGallery()" placeholder="タイトルや対戦カードを検索..." class="w-full bg-slate-800/80 border border-slate-700 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <select id="tagFilter" onchange="renderGallery()" class="bg-slate-800/80 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="ALL">すべてのタグ</option>
                    <option value="⭐ お気に入り">⭐ お気に入り</option>
                    <option value="🏆 試合・大会">🏆 試合・大会</option>
                    <option value="🔥 神業・必殺技">🔥 神業・必殺技</option>
                    <option value="✨ 栄光の瞬間">✨ 栄光の瞬間</option>
                </select>
            </div>

            <!-- View Mode Switcher -->
            <div class="flex items-center space-x-1 bg-slate-800/80 p-1 rounded-xl border border-slate-700 self-end md:self-auto">
                <button onclick="setViewMode('grid')" id="btnViewGrid" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition text-indigo-300 bg-indigo-900/60 border border-indigo-500/30">
                    <i class="fa-solid fa-border-all mr-1"></i> グリッド
                </button>
                <button onclick="setViewMode('timeline')" id="btnViewTimeline" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-timeline mr-1"></i> タイムライン
