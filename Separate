                    <i id="slideshowCheckIcon" class="fa-regular fa-circle-check text-lg"></i>
                    <span id="slideshowCheckText">チェックする</span>
                </button>
            </div>

            <!-- Nav Controls -->
            <button onclick="prevSlide(true)" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-slate-900/80 hover:bg-slate-800 text-white rounded-full flex items-center justify-center border border-slate-700 transition shadow-lg">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button onclick="nextSlide(true)" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-slate-900/80 hover:bg-slate-800 text-white rounded-full flex items-center justify-center border border-slate-700 transition shadow-lg">
                <i class="fa-solid fa-chevron-right"></i>
