            </div>
        </div>

        <!-- Gallery Display Container -->
        <div id="galleryContainer" class="min-h-[400px]">
            <!-- Dynamic Grid/Timeline rendering via JS -->
        </div>
    </main>

    <!-- Edit & Detail Modal -->
    <div id="editModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-2xl rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <h3 class="font-bold text-slate-200 text-sm sm:text-base" id="modalTitle">写真情報の編集</h3>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-4 sm:p-6 overflow-y-auto space-y-4 flex-1">
