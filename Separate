                <p class="text-xs sm:text-sm text-slate-400">チェックをつけた写真の番号一覧です。</p>
            </div>

            <!-- Checked Numbers Display Area -->
            <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-5">
                <div id="resultNumbersList" class="flex flex-wrap items-center justify-center gap-3">
                    <!-- Dynamic badges populated via JS -->
                </div>
            </div>

            <div class="pt-4 border-t border-slate-800/80 space-y-3">
                <button onclick="closeResultModal()" class="w-full py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs sm:text-sm font-medium rounded-xl transition">
                    ギャラリーに戻る
                </button>
                <div class="p-3 bg-indigo-500/10 border border-indigo-500/20 rounded-xl">
                    <p class="text-sm font-bold text-indigo-300">
                        ✨ セパタクロー 10選 ストーリー完了 ✨
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration & Auth Setup
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'sepaktakraw-storyboard-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "AIzaSyDummyKey",
            authDomain: "dummy.firebaseapp.com",
            projectId: "dummy-project",
            storageBucket: "dummy.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:123456"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        let currentUser = null;

        async function initAuth() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.warn("Auth initialization fallback mode active:", err.message);
            }
        }

        onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (user) {
                loadPhotosFromFirestore();
            }
        });

        initAuth();

        // Toast Helper
        function showToast(msg, icon = 'fa-circle-check') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = "animate-toast px-4 py-2.5 bg-slate-800/90 text-slate-100 text-xs font-semibold rounded-xl border border-slate-700 shadow-2xl backdrop-blur-md flex items-center gap-2 pointer-events-auto";
            toast.innerHTML = `<i class="fa-solid ${icon} text-indigo-400"></i> ${msg}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(100%)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        // Save Status UI Helper
        function setSaveStatus(status) {
            const el = document.getElementById('saveStatus');
            if (!el) return;
            if (status === 'saving') {
                el.className = "px-2 py-0.5 text-[10px] rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 font-medium inline-flex items-center gap-1";
                el.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> 処理・保存中...';
            } else if (status === 'saved') {
                el.className = "px-2 py-0.5 text-[10px] rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-medium inline-flex items-center gap-1";
                el.innerHTML = '<i class="fa-solid fa-cloud-check"></i> 保存済み';
            } else if (status === 'error') {
                el.className = "px-2 py-0.5 text-[10px] rounded-md bg-rose-500/20 text-rose-300 border border-rose-500/30 font-medium inline-flex items-center gap-1";
                el.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> 保存失敗';
            }
        }

        // Save photo state to Firestore
        async function savePhotosToFirestore() {
            if (!currentUser) return;
            setSaveStatus('saving');
            try {
                const docRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'storyboard', 'data');
                await setDoc(docRef, { photos: photos, updatedAt: new Date().toISOString() });
                setSaveStatus('saved');
            } catch (err) {
                console.error("Failed to save photos to cloud:", err);
                setSaveStatus('error');
            }
        }

        // Load photo state from Firestore
        async function loadPhotosFromFirestore() {
            if (!currentUser) return;
            try {
                const docRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'storyboard', 'data');
                const docSnap = await getDoc(docRef);
                if (docSnap.exists() && docSnap.data().photos) {
                    photos = docSnap.data().photos;
                    renderGallery();
                    updatePhotoCount();
                    setSaveStatus('saved');
                } else {
                    savePhotosToFirestore();
                }
            } catch (err) {
                console.error("Failed to load photos from cloud:", err);
            }
        }

        // Image compression helper (Optimized to fit within Firestore document limits)
        function compressImage(file, maxWidth = 600, maxHeight = 338, quality = 0.55) {
            return new Promise((resolve) => {
                if (!file || !file.type.startsWith('image/')) {
                    resolve(null);
                    return;
                }
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let width = img.width;
                        let height = img.height;

                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }
                        if (height > maxHeight) {
                            width = Math.round((width * maxHeight) / height);
                            height = maxHeight;
                        }

                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        resolve(canvas.toDataURL('image/jpeg', quality));
                    };
                    img.onerror = () => resolve(e.target.result);
                    img.src = e.target.result;
                };
                reader.onerror = () => resolve(null);
                reader.readAsDataURL(file);
            });
        }

        // 10枚のSVGサムネイル生成関数
        function createExactPhotoSvg(id) {
            let innerContent = "";

            if (id === 1) {
                innerContent = `
                    <defs>
                        <linearGradient id="bg1" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#2a1f1d"/>
                            <stop offset="60%" stop-color="#a85718"/>
                            <stop offset="100%" stop-color="#1e293b"/>
                        </linearGradient>
                    </defs>
                    <rect width="800" height="450" fill="url(#bg1)"/>
                    <polygon points="0,220 800,220 800,450 0,450" fill="#b45309" opacity="0.8"/>
                    <polygon points="0,320 800,300 800,450 0,450" fill="#15803d" opacity="0.8"/>
                    <line x1="150" y1="180" x2="150" y2="380" stroke="#f8fafc" stroke-width="8"/>
                    <rect x="35" y="250" width="100" height="100" fill="#f8fafc" rx="6" opacity="0.9"/>
                    <g transform="translate(250,230) scale(1.1)">
                        <circle cx="0" cy="0" r="18" fill="#0284c7"/>
                        <path d="M-10,18 L0,80 L-30,120 M0,80 L40,110" stroke="#0284c7" stroke-width="14" stroke-linecap="round"/>
                        <path d="M0,20 L60,-40" stroke="#0284c7" stroke-width="12" stroke-linecap="round"/>
                    </g>
                    <g transform="translate(600,180) scale(1.2)">
                        <circle cx="0" cy="0" r="18" fill="#16a34a"/>
                        <path d="M0,18 L10,70 L-20,110 M10,70 L30,100" stroke="#16a34a" stroke-width="14" stroke-linecap="round"/>
                        <path d="M0,20 L30,-70" stroke="#16a34a" stroke-width="12" stroke-linecap="round"/>
                        <circle cx="35" cy="-80" r="12" fill="#f59e0b"/>
