            <!-- Shortcut hints -->
            <div class="hidden md:flex items-center gap-3 text-[11px] text-slate-400">
                <span><kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-300 font-mono">←</kbd> 前へ</span>
                <span><kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-300 font-mono">→</kbd> 次へ</span>
                <span><kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-300 font-mono">Space</kbd> チェック</span>
                <span><kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-300 font-mono">Esc</kbd> 閉じる</span>
            </div>

            <button onclick="closeSlideshow()" class="text-slate-400 hover:text-white p-2 text-xl transition">
